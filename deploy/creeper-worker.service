[Unit]
Description=Creeper Task Worker — distributed scan task executor
After=network-online.target creeper-hub.service
Wants=network-online.target creeper-hub.service

[Service]
Type=simple
User=creeper
Group=creeper
WorkingDirectory=/opt/creeper
Environment=RUST_LOG=info
ExecStart=/opt/creeper/creeper worker --hub http://127.0.0.1:9090 --poll-interval 60
Restart=always
RestartSec=10
StandardOutput=journal
StandardError=journal

NoNewPrivileges=yes
ProtectSystem=strict
ProtectHome=yes
ReadWritePaths=/opt/creeper/data
PrivateTmp=yes

[Install]
WantedBy=multi-user.target